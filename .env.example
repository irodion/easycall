# Firebase project configuration
# Copy this file to .env.local and fill in your Firebase project values
# Get these from: Firebase Console → Project Settings → General → Your apps

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Realtime Database URL
# Get from: Firebase Console → Realtime Database → URL at top of page
VITE_FIREBASE_DATABASE_URL=

# Firebase Cloud Messaging VAPID key
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# reCAPTCHA v3 site key for Firebase App Check
# Create at: Google Cloud Console → reCAPTCHA → Create Key (Score-based, v3)
# Then register in: Firebase Console → App Check → reCAPTCHA v3
VITE_RECAPTCHA_V3_SITE_KEY=
