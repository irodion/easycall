# Production Firebase configuration
# Copy to .env.production and fill in values from Firebase Console

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# FCM Web Push VAPID key
# Generate: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=

# JaaS (Jitsi as a Service) App ID
# Get from: https://jaas.8x8.vc/#/apikeys
VITE_JAAS_APP_ID=

# reCAPTCHA v3 site key for Firebase App Check (required in production)
# Get from: https://www.google.com/recaptcha/admin — create a v3 site key
VITE_RECAPTCHA_V3_SITE_KEY=
