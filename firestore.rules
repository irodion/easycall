rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is a caregiver of the given elderly user
    function isCaregiverOf(elderlyUserId, caregiverUid) {
      return exists(/databases/$(database)/documents/users/$(elderlyUserId)/caregivers/$(caregiverUid));
    }

    // Registration lock: readable by anyone (shown on pre-auth role selector).
    // Only contains { open: boolean } — no sensitive data.
    // Writes go through Cloud Functions (admin SDK).
    match /config/registration {
      allow read: if true;
      allow write: if false;
    }

    // PIN status flag: readable by anyone (checked on pre-auth role selector).
    // Only contains { pinSet: boolean } — no secrets.
    // Written by Cloud Functions only.
    match /config/caregiverPinStatus {
      allow read: if true;
      allow write: if false;
    }

    // Billing alert status: readable by anyone (shown on caregiver dashboard).
    // Only contains spend amounts and threshold — no sensitive data.
    // Written by Cloud Functions only.
    match /config/billingAlert {
      allow read: if true;
      allow write: if false;
    }

    // PIN hash and legacy PIN doc: NO client access at all.
    // Server-only via admin SDK.
    match /config/caregiverPin {
      allow read, write: if false;
    }
    match /config/caregiverPinHash {
      allow read, write: if false;
    }

    // Room ownership index: maintained by onContactWritten Cloud Function.
    // Read and written exclusively via admin SDK — no client access.
    match /roomOwners/{roomId} {
      allow read, write: if false;
    }

    // Rate limit counters: written exclusively by Cloud Functions (admin SDK).
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Audit log: written exclusively by Cloud Functions (admin SDK).
    // Caregivers can read entries where they are the actor.
    match /auditLog/{entryId} {
      allow read: if request.auth != null
        && resource.data.caregiverUid == request.auth.uid;
      allow write: if false;
    }

    match /users/{userId} {
      // Users can read their own profile, or a linked caregiver can read it
      // (needed for the caregiver dashboard to show elderly user names/status)
      allow read: if request.auth.uid == userId
        || isCaregiverOf(userId, request.auth.uid);
      // Users can update their own profile but cannot change their role once set.
      // Linked caregivers can also update settings (e.g. font size, restricted network mode).
      allow update: if (request.auth.uid == userId || isCaregiverOf(userId, request.auth.uid))
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
        // Throttle displayName changes: require 30s gap between updates.
        // Prevents triggering expensive collectionGroup sync in onUserProfileChanged.
        && (
          !('displayName' in request.resource.data)
          || request.resource.data.displayName == resource.data.displayName
          || !('lastDisplayNameChange' in resource.data)
          || request.time > resource.data.lastDisplayNameChange + duration.value(30, 's')
        );
      allow delete: if request.auth.uid == userId;
      // New user creation: role must be 'elderly' (caregiver goes through Cloud Function).
      allow create: if request.auth.uid == userId
        && request.resource.data.role == 'elderly';

      // Contacts: owner or linked caregiver
      match /contacts/{contactId} {
        allow read, write: if request.auth.uid == userId
          || isCaregiverOf(userId, request.auth.uid);
      }

      // Caregivers subcollection: read-only from client.
      // Write is performed exclusively by the validatePairingCode Cloud Function
      // (admin SDK bypasses these rules). Allowing client writes here would let
      // any authenticated user self-grant caregiver access to any elderly account.
      match /caregivers/{caregiverUserId} {
        allow read: if request.auth.uid == userId
          || request.auth.uid == caregiverUserId;
        allow write: if false;
      }

      // Incoming call signaling (single doc "current", overwritten per call)
      match /incomingCall/current {
        allow read: if request.auth.uid == userId
          || (resource != null && request.auth.uid == resource.data.callerId);
        allow create: if request.auth != null
          && request.resource.data.callerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['callerId', 'callerName', 'callerPhotoURL', 'jitsiRoomId', 'status', 'timestamp'])
          && request.resource.data.keys().hasAll(['callerId', 'callerName', 'jitsiRoomId', 'status', 'timestamp'])
          && request.resource.data.status == 'ringing';
        allow update: if (request.auth.uid == userId || request.auth.uid == resource.data.callerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if request.auth.uid == userId
          || (resource != null && request.auth.uid == resource.data.callerId);
      }

      // Active call tracking (single doc "current", for auto-rejoin)
      match /activeCall/current {
        allow read: if request.auth.uid == userId;
        allow create, update: if request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['contactId', 'contactName', 'jitsiRoomId', 'startedAt', 'status'])
          && request.resource.data.keys().hasAll(['contactId', 'contactName', 'jitsiRoomId', 'startedAt', 'status'])
          && request.resource.data.contactId is string
          && request.resource.data.contactName is string
          && request.resource.data.jitsiRoomId is string
          && request.resource.data.startedAt is timestamp
          && request.resource.data.status in ['active', 'ended'];
        allow delete: if request.auth.uid == userId;
      }

      // Call history: owner or linked caregiver can read; owner can create (immutable)
      match /callHistory/{callId} {
        allow read: if request.auth.uid == userId
          || isCaregiverOf(userId, request.auth.uid);
        allow create: if request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['contactId', 'contactName', 'direction', 'outcome', 'duration', 'startedAt', 'endedAt'])
          && request.resource.data.keys().hasAll(['contactId', 'contactName', 'direction', 'outcome', 'duration', 'startedAt', 'endedAt'])
          && request.resource.data.direction in ['outgoing', 'incoming']
          && request.resource.data.outcome in ['completed', 'missed', 'declined']
          && request.resource.data.duration is int
          && request.resource.data.duration >= 0
          && request.resource.data.startedAt is timestamp
          && request.resource.data.startedAt <= request.time
          && request.resource.data.endedAt is timestamp
          && request.resource.data.endedAt >= request.resource.data.startedAt
          && request.resource.data.endedAt <= request.time;
        allow update: if false;
        allow delete: if false;
      }
    }

    // Direct links: created by Cloud Functions (admin SDK).
    // Caregivers can read links they created.
    match /directLinks/{linkId} {
      allow read: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
      allow write: if false;
    }

    // Direct link room index: server-only (webhook handler reads via admin SDK).
    match /directLinksByRoom/{roomId} {
      allow read, write: if false;
    }

    // Pairing codes: owner can read own codes, owner can create
    match /pairingCodes/{code} {
      allow read: if request.auth != null
        && resource.data.elderlyUserId == request.auth.uid;
      allow create: if request.auth != null
        && code.matches('^[0-9]{6}$')
        && request.resource.data.elderlyUserId == request.auth.uid
        && request.resource.data.keys().hasAll(['elderlyUserId', 'expiresAt', 'used'])
        && request.resource.data.used == false
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 600000;
    }
  }
}
