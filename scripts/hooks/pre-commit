#!/bin/sh
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "ERROR: Direct commits to 'main' are not allowed."
  echo "Create a feature branch first: git checkout -b feat/<name>"
  exit 1
fi

echo "Running semgrep security scan..."
if command -v semgrep >/dev/null 2>&1; then
  semgrep --config auto --config .semgrep.yml --error --severity ERROR --quiet
  if [ $? -ne 0 ]; then
    echo "ERROR: Semgrep found security issues. Fix them before committing."
    exit 1
  fi
  echo "Semgrep scan passed."
else
  echo "ERROR: semgrep not installed — security scan is required."
  echo "Install with: brew install semgrep"
  exit 1
fi

if git diff --cached --name-only | grep -qE '^(pnpm-lock\.yaml|package\.json)$'; then
  echo ""
  echo "⚠ Dependencies changed — run 'pnpm security:deps' to check for vulnerabilities."
  echo ""
fi

echo "Running tests before commit..."
pnpm test
