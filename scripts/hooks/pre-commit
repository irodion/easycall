#!/bin/sh
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "ERROR: Direct commits to 'main' are not allowed."
  echo "Create a feature branch first: git checkout -b feat/<name>"
  exit 1
fi

echo "Running semgrep security scan..."
if command -v semgrep >/dev/null 2>&1; then
  semgrep --config auto --config .semgrep.yml --error --severity ERROR --quiet
  if [ $? -ne 0 ]; then
    echo "ERROR: Semgrep found security issues. Fix them before committing."
    exit 1
  fi
  echo "Semgrep scan passed."
else
  echo "ERROR: semgrep not installed — security scan is required."
  echo "Install with: brew install semgrep"
  exit 1
fi

if git diff --cached --name-only --diff-filter=ACMR | grep -q .; then
  echo "Checking formatting..."

  # Only stash if there are unstaged changes to tracked files.
  # This prevents conflicts with new untracked files during stash pop.
  HAS_UNSTAGED=$(git diff --name-only | head -1)
  STASHED=1
  if [ -n "$HAS_UNSTAGED" ]; then
    git stash push --keep-index --quiet --message "pre-commit: unstaged changes" 2>/dev/null
    STASHED=$?
  fi

  # Pipe NUL-delimited paths directly to xargs (echo loses NUL bytes).
  git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 npx prettier --write --ignore-unknown
  git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 git add

  if [ "$STASHED" -eq 0 ]; then
    git stash pop --quiet 2>/dev/null || true
  fi

  echo "Formatting applied."
fi

if git diff --cached --name-only | grep -qE '^(pnpm-lock\.yaml|package\.json)$'; then
  echo ""
  echo "⚠ Dependencies changed — run 'pnpm security:deps' to check for vulnerabilities."
  echo ""
fi

echo "Running lint..."
pnpm lint
if [ $? -ne 0 ]; then
  echo "ERROR: Lint failed. Fix errors before committing."
  exit 1
fi

echo "Running tests before commit..."
pnpm test
